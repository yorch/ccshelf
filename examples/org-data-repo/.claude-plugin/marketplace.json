{
  "name": "acme",
  "owner": {
    "name": "Acme Platform Team"
  },
  "description": "Acme's internal Claude Code plugins. Fictional example data for the ccshelf starter template.",
  "plugins": [
    {
      "name": "design-kit",
      "source": "./plugins/design-kit",
      "displayName": "Design Kit",
      "description": "Component review and accessibility checks for the Acme web design system.",
      "category": "design",
      "tags": ["frontend", "react", "css", "accessibility", "components"],
      "author": { "name": "Acme Web Team" },
      "homepage": "https://wiki.acme.example/design-kit",
      "license": "MIT",
      "keywords": ["design system", "components", "wcag"]
    },
    {
      "name": "sre-kit",
      "source": "./plugins/sre-kit",
      "displayName": "SRE Kit",
      "description": "Incident timelines, postmortem drafts and a production-context guard for on-call engineers.",
      "category": "operations",
      "tags": ["sre", "incident-response", "runbooks", "postmortem"],
      "author": { "name": "Acme SRE Team" },
      "homepage": "https://wiki.acme.example/sre-kit",
      "license": "MIT",
      "keywords": ["incident", "on-call", "kubernetes"],
      "relevance": {
        "topic": "Infrastructure and incident work",
        "signals": {
          "cwd": ["infra", "terraform", "k8s"],
          "cli": ["kubectl", "terraform"],
          "filesRead": ["main.tf", "kustomization.yaml"]
        }
      }
    },
    {
      "name": "seo-tools",
      "source": "./plugins/seo-tools",
      "displayName": "SEO Tools",
      "description": "Search audit skill and a read-only Search Console MCP server for the SEO team.",

      "tags": ["seo", "search", "content"],
      "author": { "name": "Acme SEO Team" },
      "homepage": "https://wiki.acme.example/seo-tools",
      "license": "MIT",
      "keywords": ["search console", "sitemap", "metadata"],
      "relevance": {
        "topic": "Search engine optimization of web content",
        "signals": {
          "filesRead": ["sitemap.xml", "robots.txt"]
        }
      }
    },
    {
      "name": "release-notes",
      "source": "./plugins/release-notes",
      "displayName": "Release Notes",
      "description": "Deprecated: drafts release notes from merged pull requests. Use docs-writer instead.",
      "category": "documentation",
      "tags": ["changelog", "docs", "writing"],
      "author": { "name": "Acme Platform Team" },
      "license": "MIT",
      "keywords": ["changelog", "release"]
    },
    {
      "name": "docs-writer",
      "source": "./plugins/docs-writer",
      "displayName": "Docs Writer",
      "description": "Structures technical documentation, API references and release notes in the Acme house style.",
      "category": "documentation",
      "tags": ["docs", "writing", "changelog"],
      "author": { "name": "Acme Platform Team" },
      "homepage": "https://wiki.acme.example/docs-writer",
      "license": "MIT",
      "keywords": ["documentation", "api reference", "release notes"]
    },
    {
      "name": "audit-logger",
      "source": "./plugins/audit-logger",
      "displayName": "Audit Logger",
      "description": "Records tool use for compliance review. Protected: profiles may not mask it.",
      "category": "security",
      "tags": ["audit", "compliance"],
      "author": { "name": "Acme Platform Team" },
      "license": "MIT",
      "keywords": ["audit", "compliance", "hooks"]
    },
    {
      "name": "partner-linter",
      "source": {

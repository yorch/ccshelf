name: validate

# Generated by "ccshelf catalog init". Edit freely; nothing regenerates this file.
# Runs on pull requests, including from forks, with a read-only token and no secrets.
[[if not .ProfilesOnly]]# The preview artifact is built from untrusted content: it is never published.
[[end]]on:
  pull_request:

permissions: {}

concurrency:
  group: validate-${{ github.ref }}
  cancel-in-progress: true

jobs:[[if not .Pin.Pinned]]
  # TODO(ccshelf): once the ccshelf action below is pinned (see README.md), delete this job and the
  # "needs: guard" line of the validate job. It is a job of its own on purpose: the runner resolves
  # every action of a job before its first step runs, so a guard step inside that job could never
  # run ahead of the unresolvable placeholder; a failed "guard" skips the jobs that need it instead.
  guard:
    runs-on: ${{ vars.RUNNER_LABEL || '[[.Runner]]' }}
    timeout-minutes: 2
    permissions: {}
    steps:
      - name: Refuse to run until ccshelf is pinned
        run: |
          echo "::error title=ccshelf is not pinned::The ccshelf action in this workflow still has the placeholder commit SHA or version. Replace them with a released ccshelf commit SHA and tag, then delete the guard job and its needs line. See README.md."
          exit 1
[[end]]
  validate:[[if not .Pin.Pinned]]
    needs: guard[[end]]
    runs-on: ${{ vars.RUNNER_LABEL || '[[.Runner]]' }}
    timeout-minutes: 10
    permissions:
      contents: read
    steps:
      - name: Check out the pull request
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      # Set the repository variable CCSHELF_SHA256_LINUX_AMD64 to the archive hash from the release's
      # checksums.txt to pin the binary too. Without it the action uses the hash in its own pins.txt
      # for the pinned commit, else verifies the cosign signature, which needs cosign on PATH.
      - name: Lint [[if .ProfilesOnly]]profiles and ownership[[else]]metadata, profiles and ownership[[end]]
        uses: yorch/ccshelf/action@[[.Pin.SHA]] # [[.Comment]]
        with:
          version: [[.Pin.Version]]
          sha256: ${{ vars.CCSHELF_SHA256_LINUX_AMD64 }}
          args: lint
[[if not .ProfilesOnly]]
      - name: Check that committed bundles match the profiles
        uses: yorch/ccshelf/action@[[.Pin.SHA]] # [[.Comment]]
        with:
          version: [[.Pin.Version]]
          sha256: ${{ vars.CCSHELF_SHA256_LINUX_AMD64 }}
          args: compile --check

      - name: Build the catalog preview
        uses: yorch/ccshelf/action@[[.Pin.SHA]] # [[.Comment]]
        with:
          version: [[.Pin.Version]]
          sha256: ${{ vars.CCSHELF_SHA256_LINUX_AMD64 }}
          args: catalog build --out dist/catalog

      # Optional: set the repository variable UPLOAD_PREVIEW to 'false' where upload-artifact
      # is not available (older GitHub Enterprise Server).
      # Optional: set the repository variable CLAUDE_VALIDATE to 'true' to also run the native
      # validator. It needs Claude Code on the runner (GHES runners may not be able to install it).
      - name: Validate the marketplace and plugins with Claude Code
        if: vars.CLAUDE_VALIDATE == 'true'
        run: claude plugin validate .

      - name: Upload the preview (not published)
        if: vars.UPLOAD_PREVIEW != 'false'
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: catalog-preview
          path: dist/catalog
          retention-days: 7
          if-no-files-found: error
[[end]]
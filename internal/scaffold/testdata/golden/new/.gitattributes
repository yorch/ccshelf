# "ccshelf catalog init" generated this file. The drift check of "ccshelf compile --check"
# compares bytes, so generated and committed files must keep LF endings on every
# platform (a Windows autocrlf clone would otherwise count as drift).
* text=auto eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.sh text eol=lf

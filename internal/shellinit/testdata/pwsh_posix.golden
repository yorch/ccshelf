# ccshelf shell integration (generated by: ccshelf shell-init pwsh).
# Defines one function per profile: cs-<profile> runs `ccshelf run <profile>`
# and passes the remaining arguments through to claude.
# Load it with: ccshelf shell-init pwsh | Out-String | Invoke-Expression
function cs-frontend { & '/opt/it''s/ccshelf' run frontend @args }
function cs-seo-2 { & '/opt/it''s/ccshelf' run seo-2 @args }
function cs-sre { & '/opt/it''s/ccshelf' run sre @args }

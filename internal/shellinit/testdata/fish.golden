# ccshelf shell integration (generated by: ccshelf shell-init fish).
# Defines one function per profile: cs-<profile> runs `ccshelf run <profile>`
# and passes the remaining arguments through to claude.
# Load it with: ccshelf shell-init fish | source
function cs-frontend --description 'ccshelf profile frontend'
    '/opt/it\'s/ccshelf' run frontend $argv
end
function cs-seo-2 --description 'ccshelf profile seo-2'
    '/opt/it\'s/ccshelf' run seo-2 $argv
end
function cs-sre --description 'ccshelf profile sre'
    '/opt/it\'s/ccshelf' run sre $argv
end

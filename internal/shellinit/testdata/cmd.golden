REM ccshelf shell integration (generated by: ccshelf shell-init cmd).
REM Defines one function per profile: cs-<profile> runs `ccshelf run <profile>`
REM and passes the remaining arguments through to claude.
REM Load it with: ccshelf shell-init cmd > "%TEMP%\ccshelf-init.cmd" && call "%TEMP%\ccshelf-init.cmd"
REM These doskey macros last for this console window only. For persistent
REM commands, use .cmd shims on PATH instead.
doskey cs-frontend="C:\Program Files\ccshelf\ccshelf.exe" run frontend $*
doskey cs-seo-2="C:\Program Files\ccshelf\ccshelf.exe" run seo-2 $*
doskey cs-sre="C:\Program Files\ccshelf\ccshelf.exe" run sre $*

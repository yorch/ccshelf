{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccshelf.dev/schema/config.schema.json",
  "title": "ccshelf user config",
  "description": "~/.config/ccshelf/config.toml. Closed schema: unknown keys are errors.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["dir", "git", "plugin"] },
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "path": { "type": "string" },
        "url": { "type": "string" },
        "ref": { "type": "string" },
        "plugin": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*@[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "marketplace": { "type": "string", "minLength": 1, "description": "Plugin sources only: the owner/repo or git URL the plugin's marketplace must have been added from." }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_dir"],
      "properties": {
        "config_dir": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "default_account": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_pin": { "type": "boolean" },
        "on_change": { "enum": ["prompt", "fail"] },
        "trust_project_profiles": { "type": "boolean" }
      }
    },
    "accounts": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
      "additionalProperties": { "$ref": "#/$defs/account" }
    },
    "claude": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "enum": ["auto", "always", "never"] },
        "interactive": { "enum": ["auto", "never"] }
      }
    }
  }
}

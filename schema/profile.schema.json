{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccshelf.dev/schema/profile.schema.json",
  "title": "ccshelf profile manifest",
  "description": "One profile file, profiles/<name>.toml, as a JSON document. Closed schema (SR1): a profile cannot carry permissions, hooks, auth settings or MCP definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "$defs": {
    "pluginId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*@[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "skillName": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
    "profileName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "phrase": { "type": "string", "minLength": 1 },
    "envName": {
      "allOf": [
        {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        {
          "pattern": "^(CCSHELF_VAR_[A-Z0-9_]{1,40}|[A-Z][A-Z0-9_]{0,55}_REF)$"
        },
        {
          "not": {
            "pattern": "^(ANTHROPIC_|CLAUDE_CODE_|CLAUDE_|NODE_|OTEL_|DYLD_|LD_|GIT_|SSH_|AWS_|AZURE_|GOOGLE_|NPM_|PYTHON|PERL|RUBY|JAVA_|_JAVA|JDK_|BUN_|DENO_|ELECTRON_|DOCKER_|KUBE|PIP_|CARGO_|YARN_|GEM_|BASH|ZSH|GITHUB_|RUNNER_|ACTIONS_)"
          }
        },
        {
          "not": {
            "pattern": "(_OPTIONS|_OPTS)$"
          }
        },
        {
          "not": {
            "pattern": "_PROXY"
          }
        },
        {
          "not": {
            "enum": [
              "ALL_PROXY",
              "BASHOPTS",
              "BASH_ENV",
              "BROWSER",
              "CI",
              "CURL_CA_BUNDLE",
              "EDITOR",
              "ENV",
              "GCONV_PATH",
              "HOME",
              "HTTPS_PROXY",
              "HTTP_PROXY",
              "IFS",
              "KUBECONFIG",
              "LESSCLOSE",
              "LESSOPEN",
              "NO_PROXY",
              "PAGER",
              "PATH",
              "PERL5OPT",
              "PROMPT_COMMAND",
              "PS4",
              "PYTHONPATH",
              "PYTHONSTARTUP",
              "REQUESTS_CA_BUNDLE",
              "RUBYOPT",
              "SHELL",
              "SHELLOPTS",
              "SSLKEYLOGFILE",
              "SSL_CERT_DIR",
              "SSL_CERT_FILE",
              "TEMP",
              "TMP",
              "TMPDIR",
              "USER",
              "VISUAL",
              "ZDOTDIR"
            ]
          }
        }
      ]
    }
  },
  "properties": {
    "name": { "$ref": "#/$defs/profileName" },
    "description": { "type": "string" },
    "owner": { "type": "string" },
    "status": { "enum": ["active", "experimental", "deprecated"] },
    "superseded_by": { "$ref": "#/$defs/profileName" },
    "account": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "extends": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/profileName" } },
    "when_to_use": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/phrase" } },
    "avoid_when": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/phrase" } },
    "plugins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["allow-only", "additive"] },
        "include": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/pluginId" } },
        "exclude": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/pluginId" } }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "off": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/skillName" } },
        "name_only": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/skillName" } }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "servers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" } },
        "claudeai_connectors": { "enum": ["none", "keep"] },
        "strict": { "type": "boolean" }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\[\\]-]{0,127}$" },
        "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
        "append_system_prompt_file": { "type": "string", "pattern": "^prompts/([^/\\\\.][^/\\\\]*/)*[^/\\\\.][^/\\\\]*$" },
        "inherit_user_settings": { "type": "boolean" },
        "env": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/envName" },
          "additionalProperties": { "type": "string", "maxLength": 4096 }
        }
      }
    },
    "instructions": {
      "type": "object",
      "description": "Files that ccshelf joins into one CLAUDE.md for the session. Each file is a path below prompts/ in the source of the profile.",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": { "type": "string", "pattern": "^prompts/([^/\\\\.][^/\\\\]*/)*[^/\\\\.][^/\\\\]*$" }
        },
        "inherit": { "type": "boolean", "description": "Default true: the files come after the files of the parent profiles. False drops the files of all parent profiles." }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_blocked": { "enum": ["warn", "fail"] }
      }
    }
  }
}
